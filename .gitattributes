# Normalize line endings — prevents CRLF/LF churn from tripping
# `git diff --check` on any platform (P-08, 2026-08-13).
* text=auto eol=lf

# Binary files stay untouched.
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# drvfs (WSL /mnt) misdetects CRLF package.json as binary; force explicit text.
package.json text eol=lf
