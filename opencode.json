{
  "plugin": [
    "opencode-subagent-control@latest"
  ],
  "$schema": "https://opencode.ai/config.json",
   "subagent_depth": 2,  
   "mcp": {
        "codegraph": {
            "type": "local",
            "command": [
                "codegraph-mcp",
                "--workspace",
                "D:/software-dev/proofloopv2",
                "--profile",
                "graph"
            ],
            "cwd": "D:/software-dev/proofloopv2",
            "enabled": true
        },
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "@playwright/mcp@latest"
            ],
            "enabled": false
        },
        "context7": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@upstash/context7-mcp",
                "--api-key",
                "{env:CONTEXT7_API_KEY}"
            ],
            "enabled": true
        },
        "chrome-devtools": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest",
                "--no-usage-statistics",
                "--headless", "true"
            ],
            "enabled": false
        }
    },  
  "lsp": true 
}